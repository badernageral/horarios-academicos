{
  "name": "sga-desktop",
  "version": "1.0.1",
  "description": "SGA — Horários Acadêmicos (empacotamento desktop para Windows)",
  "author": "IFTO",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "br.edu.ifto.sga",
    "productName": "SGA Horarios",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json"],
    "extraResources": [
      { "from": "runtime", "to": "runtime" },
      { "from": "router.php", "to": "router.php" },
      { "from": "../", "to": "app", "filter": [
        "**/*",
        "!desktop/**",
        "!backups/**",
        "!.git/**",
        "!**/node_modules/**"
      ] }
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "guid": "75de4476-d62e-4c65-a5bb-f472d7c2fb00",
      "artifactName": "SGA-Setup-${version}.${ext}",
      "installerLanguages": ["pt_BR"],
      "language": "1046"
    },
    "portable": {
      "artifactName": "SGA-Portable-${version}.${ext}"
    }
  }
}
